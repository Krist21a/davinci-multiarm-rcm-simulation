  "wrong_threshold_m": 0.002,
  "definitions": {
   "tip_truth": "tcp_M[:3,3] of the cutter tcp (true sim pose)",
   "jaw_axis_truth": "tcp_M[:3, tool_axis_col] (pointing axis used by tool_pose control)",
   "front_truth": "GroundTruth.cut_front: midpoint of the two centre columns at row round(cut_length/H) (1 mm grid quantisation)",
   "direction_truth_live": "centre-line m_j = (n[j,NU/2-1]+n[j,NU/2])/2; j0 = min(round(cut_length/H), NV-4); unit(m[j0+3]-m[j0])",
   "direction_truth_placement": "sheet_v at placement (reported for comparison with M4, not gated)",
   "truth_visible": "visibility.depth_visible on the true camera/depth with SimWorld.point_visible defaults (tol 3 mm, window 21, min_clear 0.35)",
   "valid_but_wrong_rate": "#(estimate valid AND error > wrong_threshold_m) / #(estimate valid)",
   "availability": "#(estimate valid) / #(ticks with the sheet present AND the truth point visible)",
   "relative_error": "|(front_est - tip_est) - (front_true - tip_true)| on ticks where both estimates are valid; the quantity a relative visual servo consumes",
   "pre_sheet_false_positive": "tick with no sheet in the scene but cut.valid or cut.front_valid true"
  },
